{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "SmartSort install dependencies",
			"type": "shell",
			"command": "npm",
			"args": [
				"install"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "SmartSort frontend build",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Check SmartSort launcher syntax",
			"type": "shell",
			"command": "node",
			"args": [
				"--check",
				"run-dev.mjs"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "SmartSort type check",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"lint"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}